<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Canvas -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top toolbar: colors + brush sizes -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:background="@drawable/top_toolbar_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="2dp">

        <!-- Color buttons (50dp) -->
        <ImageButton
            android:id="@+id/btnRed"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/red_circle"
            android:contentDescription="Red color" />

        <ImageButton
            android:id="@+id/btnBlue"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/blue_circle"
            android:contentDescription="Blue color" />

        <ImageButton
            android:id="@+id/btnGreen"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/green_circle"
            android:contentDescription="Green color" />

        <ImageButton
            android:id="@+id/btnPurple"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/purple_circle"
            android:contentDescription="Purple color" />

        <ImageButton
            android:id="@+id/btnPink"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/pink_circle"
            android:contentDescription="Pink color" />

        <!-- Brush size buttons (small/medium/large) -->
        <ImageButton
            android:id="@+id/btnSmall"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/brush_small"
            android:contentDescription="Small brush" />

        <ImageButton
            android:id="@+id/btnMedium"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/brush_medium"
            android:contentDescription="Medium brush" />

        <ImageButton
            android:id="@+id/btnLarge"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/brush_large"
            android:contentDescription="Large brush" />
    </LinearLayout>

    <!-- Clear button at bottom -->
    <ImageButton
        android:id="@+id/btnClear"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:background="@drawable/clear_button_bg"
        android:contentDescription="Clear canvas"
        android:scaleType="centerInside"
        android:src="@drawable/ic_clear" />
</RelativeLayout>
