<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#AA888888"/> <!-- slightly darker when pressed -->
            <size android:width="70dp" android:height="70dp"/>
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#88AAAAAA"/> <!-- semi-transparent gray -->
            <size android:width="70dp" android:height="70dp"/>
        </shape>
    </item>

</selector>
