<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_green"
        app:title="Scan Result"
        app:titleTextColor="@color/text_on_green"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <!-- Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Result Type Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:weightSum="2"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/ivResultIcon"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Type: "
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvResultType"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="QR Code"
                        android:textSize="20sp"
                        android:textStyle="bold|italic"
                        android:gravity="center"
                        android:textColor="@color/text_primary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Content Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="www.example.com"
                        android:textSize="16sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Actions"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="16dp" />

                    <!-- Copy Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopy"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        style="@style/PrimaryButton"
                        android:layout_marginBottom="12dp"
                        android:text="Copy to Clipboard"
                        android:textSize="16sp"
                        app:icon="@drawable/ic_copy"
                        app:iconTint="@color/text_on_green"
                        app:iconGravity="start"
                        app:iconPadding="8dp" />

                    <!-- Share Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShare"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        style="@style/PrimaryButton"
                        android:layout_marginBottom="12dp"
                        android:text="Share"
                        android:textSize="16sp"
                        app:icon="@drawable/ic_share"
                        app:iconTint="@color/text_on_green"
                        app:iconGravity="start"
                        app:iconPadding="8dp" />

                    <!-- Search Product Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSearch"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        style="@style/PrimaryButton"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        android:text="Search Product"
                        android:textSize="16sp"
                        app:icon="@drawable/ic_search"
                        app:iconTint="@color/text_on_green"
                        app:iconGravity="start"
                        app:iconPadding="8dp" />

                    <!-- Open Button (only for URLs) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpen"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        style="@style/PrimaryButton"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        android:text="Open in Browser"
                        android:textSize="16sp"
                        app:icon="@drawable/ic_open"
                        app:iconTint="@color/text_on_green"
                        app:iconGravity="start"
                        app:iconPadding="8dp" />

                    <!-- Add to History Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHistory"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        style="@style/PrimaryButton"
                        android:text="Add to History"
                        android:textSize="16sp"
                        app:icon="@drawable/ic_history"
                        app:iconTint="@color/text_on_green"
                        app:iconGravity="start"
                        app:iconPadding="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>