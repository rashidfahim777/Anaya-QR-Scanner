<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_green"
        app:title="Generate QR Code"
        app:titleTextColor="@color/text_on_green"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <!-- Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/layoutFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Generate Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                style="@style/PrimaryButton"
                android:layout_marginBottom="24dp"
                android:text="Generate QR Code"
                android:textSize="16sp"
                app:icon="@drawable/ic_generate"
                app:iconTint="@color/text_on_green"
                app:iconGravity="start"
                app:iconPadding="8dp" />

            <!-- Generated QR Code Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutQrContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <!-- QR Code Image -->
                    <ImageView
                        android:id="@+id/ivQRCode"
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:scaleType="fitCenter"
                        android:background="@color/white"
                        android:padding="12dp" />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="24dp"
                        android:gravity="center">

                        <!-- Download Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDownload"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="Download"
                            android:textSize="11sp"
                            app:strokeColor="@color/primary_green"
                            app:strokeWidth="1dp"
                            android:textColor="@color/primary_green"
                            app:icon="@drawable/ic_download"
                            app:iconTint="@color/primary_green" />

                        <!-- Share Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShare"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Share"
                            android:textSize="11sp"
                            style="@style/PrimaryButton"
                            app:icon="@drawable/ic_share"
                            app:iconTint="@color/text_on_green" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>