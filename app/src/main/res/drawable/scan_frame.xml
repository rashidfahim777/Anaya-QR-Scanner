<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer transparent rectangle -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="3dp"
                android:color="@color/scan_frame" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Corner Top Left -->
    <item>
        <shape android:shape="rectangle">
            <size android:width="40dp" />
            <size android:height="40dp" />
            <stroke
                android:width="5dp"
                android:color="@color/scan_laser" />
        </shape>
    </item>

    <!-- Corner Top Right -->
    <item
        android:right="260dp">
        <shape android:shape="rectangle">
            <size android:width="40dp" />
            <size android:height="40dp" />
            <stroke
                android:width="5dp"
                android:color="@color/scan_laser" />
        </shape>
    </item>

    <!-- Corner Bottom Left -->
    <item
        android:top="260dp">
        <shape android:shape="rectangle">
            <size android:width="40dp" />
            <size android:height="40dp" />
            <stroke
                android:width="5dp"
                android:color="@color/scan_laser" />
        </shape>
    </item>

    <!-- Corner Bottom Right -->
    <item
        android:top="260dp"
        android:right="260dp">
        <shape android:shape="rectangle">
            <size android:width="40dp" />
            <size android:height="40dp" />
            <stroke
                android:width="5dp"
                android:color="@color/scan_laser" />
        </shape>
    </item>
</layer-list>