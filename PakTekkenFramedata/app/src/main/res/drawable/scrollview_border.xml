<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Left border (start) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#6200EE" /> <!-- Your desired border color -->
            <size android:width="2dp" /> <!-- Border thickness -->
        </shape>
    </item>

    <!-- Right border (end) -->
    <item android:gravity="right">
        <shape android:shape="rectangle">
            <solid android:color="#6200EE" /> <!-- Your desired border color -->
            <size android:width="2dp" /> <!-- Border thickness -->
        </shape>
    </item>
</layer-list>