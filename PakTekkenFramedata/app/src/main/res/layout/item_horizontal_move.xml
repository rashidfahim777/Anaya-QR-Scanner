<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- 1. Command Column -->
    <LinearLayout
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/column_border_right">

        <TextView
            android:id="@+id/tvCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2+3"
            android:textSize="14sp"
            android:textColor="#333333"
            android:padding="8dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- 2. Startup Column -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/column_border_right">

        <TextView
            android:id="@+id/tvStartup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="i16"
            android:textSize="14sp"
            android:textColor="#6200EE"
            android:textStyle="bold"
            android:padding="8dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- 3. Block Column -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/column_border_right">

        <TextView
            android:id="@+id/tvBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- 4. Hit Column -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/column_border_right">

        <TextView
            android:id="@+id/tvHit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+8"
            android:textSize="14sp"
            android:padding="8dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- 5. Counter Hit Column -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/column_border_right">

        <TextView
            android:id="@+id/tvCounterHit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+12"
            android:textSize="14sp"
            android:padding="8dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- 6. Hit Level Column -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/column_border_right">

        <TextView
            android:id="@+id/tvHitLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="h,m"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:padding="8dp"
            android:gravity="center"
            android:background="#2196F3" />
    </LinearLayout>

    <!-- 7. Damage Column -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/column_border_right">

        <TextView
            android:id="@+id/tvDamage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="25"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- 8. Notes Column (no border on last column) -->
    <LinearLayout
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sample note"
            android:textSize="14sp"
            android:textColor="#666666"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>